# CoinAlyze API
COINALYZE_API_KEY=

# Polymarket CLOB API credentials (obtain from polymarket.com)
PM_API_KEY=
PM_API_SECRET=
PM_API_PASSPHRASE=

# Polygon wallet private key (0x...)
PM_PRIVATE_KEY=

# Polygon RPC (public fallback provided in config)
POLYGON_RPC_URL=https://polygon-rpc.com

# Kalshi arbitrage trading (optional — leave blank to run in monitor-only mode)
KALSHI_EMAIL=
KALSHI_PASSWORD=

# Arb executor risk controls
ARB_MAX_DOLLARS=20        # max dollars per leg of each arb trade
ARB_MIN_PROFIT_PCT=2      # minimum ROI% to auto-execute (vs just alerting)

# Risk controls
MAX_POSITION_USDC=10
DRY_RUN=true

# Logging
LOG_LEVEL=INFO
